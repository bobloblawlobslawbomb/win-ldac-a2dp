+    // BR/EDR-only controller (LMP feature bit 38 "LE Supported (Controller)" = 0):
+    // it silently ignores LE commands, which holds the single HCI command
+    // credit and blocks every later command (including Authentication
+    // Requested) forever. Never emit LE traffic on such a controller.
+    if ((hci_stack->local_supported_features[4] & 0x40u) == 0) return false;
